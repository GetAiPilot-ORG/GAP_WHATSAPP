
# 1. VERIFY TOKEN:
# You invent this password. Example: "whatsapp_demo_access"
# You must paste this EXACT text into the Meta "Callback URL" setup screen.
WA_VERIFY_TOKEN=

# 2. APP SECRET:
# Found in Meta App Dashboard -> App Settings -> Basic -> App Secret
# It looks like a 32-character random string for security.
META_APP_SECRET=

# 3. ACCESS TOKEN:
# Found in Meta App Dashboard -> WhatsApp -> API Setup
# Must start with "EAAG" (Temporary) or "EAA..." (System User).
# It is very long.
WA_ACCESS_TOKEN=

# 4. PHONE NUMBER ID:
# Found in Meta App Dashboard -> WhatsApp -> API Setup -> "Phone number ID"
# It is usually a 15-digit number.
WA_PHONE_NUMBER_ID=
npx supabase secrets set RAZORPAY_MODE=
npx supabase secrets set RAZORPAY_MODE=

# Toggle Cookie Consent banner & dynamic SDK loading (GDPR/CCPA compliance)
VITE_ENABLE_COOKIE_CONSENT=true
